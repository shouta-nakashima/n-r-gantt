{
  "name": "n-r-gantt-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for n-r-gantt React Gantt chart library",
  "scripts": {
    "dev": "pnpm --filter n-r-gantt dev",
    "build": "pnpm --filter n-r-gantt build",
    "test": "pnpm --filter n-r-gantt test",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format:check": "pnpm -r format:check",
    "typecheck": "pnpm -r typecheck",
    "example": "pnpm --filter demo dev",
    "storybook": "pnpm --filter n-r-gantt storybook"
  },
  "keywords": [
    "gantt",
    "react",
    "chart",
    "timeline",
    "project-management"
  ],
  "author": "shouta-nakashima",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
